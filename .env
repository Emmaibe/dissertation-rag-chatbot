# RAG Chatbot Environment Configuration
# Emmanuel Ibenwankwo - MSc Dissertation 2025/26
# Copy this file to .env and fill in your values

# Groq API Key - get yours free at https://console.groq.com
GROQ_API_KEY=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

# Groq Model - llama-3.3-70b-versatile is free and highly capable
GROQ_MODEL=llama-3.3-70b-versatile

# Embedding model (runs locally, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Vector store path
CHROMA_DB_PATH=./chroma_db

# Data directory
DATA_DIR=./data

# Chunking settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval settings
TOP_K_RESULTS=4
